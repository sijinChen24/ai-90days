# 这是模板文件，会被提交到 git。
# 真实密钥写在同目录的 .env 里，那个文件永远不会被提交。
#
# 用法：cp .env.example .env   然后把值填进去

# ---------- 大模型 API ----------
# 填你实际注册的那家，用不到的留空
OPENAI_API_KEY=
OPENAI_BASE_URL=

DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---------- 模型与生成参数 ----------
DEFAULT_MODEL=
TEMPERATURE=0.7
MAX_TOKENS=2048

# ---------- 向量库（本地跑 Chroma 时用）----------
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ---------- 应用配置 ----------
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
